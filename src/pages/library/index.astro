---
import { getCollection } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";

const entries = await getCollection("project");

const library = entries.filter((entry) =>
  entry.id.startsWith("05_library/")
);
---

<ProjectLayout title="Library">
  <h1>Library</h1>

  <p>
    Additional scripts, methods, utilities, and technical notes related to
    the project.
  </p>

  <div class="library-list">
    {
      library.map((entry) => {
        const slug = entry.id.replace("05_library/", "");

        return (
          <a href={`/library/${slug}/`} class="library-card">
            <h2>{entry.data.title ?? slug}</h2>
            <span>View library entry →</span>
          </a>
        );
      })
    }
  </div>
</ProjectLayout>

<style>
  .library-list {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }

  .library-card {
    display: block;
    padding: 20px 24px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .library-card:hover {
    border-color: #0891b2;
    box-shadow: 0 4px 12px rgb(0 0 0 / 8%);
  }

  .library-card h2 {
    margin: 0 0 8px;
    font-size: 1.2rem;
  }

  .library-card span {
    color: #0891b2;
    font-size: 0.9rem;
  }
</style>


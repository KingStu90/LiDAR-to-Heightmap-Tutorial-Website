---
import { getCollection } from "astro:content";

const entries = await getCollection("project");

const tutorialSteps = [
  ["01", "Downloading LiDAR Data", "01-downloading-point-cloud-data"],
  ["02", "Downloading Imagery", "02-downloading-imagery"],
  ["03", "Reprojecting Imagery", "03-reprojecting-imagery"],
  ["04", "Colorizing Point Cloud", "04-colorizing-point-cloud"],
  ["05", "Cleaning Point Cloud", "05-cleaning-point-cloud"],
  ["06", "Isolating Ground Points", "06-isolating-ground-points"],
  ["07", "Feet to Meters", "07-ft-to-m"],
  ["08", "Scaling Point Cloud", "08-scale-50"],
  ["09a", "Merging Point Cloud", "09a-merging-point-cloud"],
  ["09b", "Creating Heightmap", "09b-creating-the-heightmap"],
  ["09c", "Merging Raster Tiles", "09c-merging-raster"],
  ["10", "Finalizing Heightmap", "10-finalizing-heightmap"],
  ["11", "Creating Basemap", "11-creating-the-basemap-cloudcompare"],
  ["12", "Finalizing Basemap", "12-finalizing-basemap"],
  ["13", "Creating Tree Placement Map", "13-isolating-trees"],
  ["14", "Finalizing Tree Placement Map", "14-finalizing-tree-placement-map"],
];

const resources = entries.filter((entry) =>
  entry.id.startsWith("07_credits_and_resources/")
);

const library = entries.filter((entry) =>
  entry.id.startsWith("05_library/")
);

const currentPath = Astro.url.pathname;

const getHeading = (entry) => {
  const match = entry.body?.match(/^##\s+(.+)$/m);
  return match ? match[1].trim() : entry.id.split("/").pop();
};
---

<!-- Mobile menu button -->
<button class="menu-button" aria-label="Open navigation" aria-expanded="false">
  <span class="menu-icon">☰</span>
  <span>Menu</span>
</button>

<!-- Mobile backdrop -->
<div class="sidebar-backdrop"></div>

<aside class="sidebar">
  <div class="brand">
    <a href={`${import.meta.env.BASE_URL}/`}>LiDAR-to-Heightmap</a>
    <div class="brand-subtitle">Beginner Tutorial</div>

    <!-- Mobile close button -->
    <button class="close-button" aria-label="Close navigation">
      ×
    </button>
  </div>

  <nav>
    <div class="section-title">PROJECT</div>

    <a
      href={`${import.meta.env.BASE_URL}/`}
      class:list={{ active: currentPath === `${import.meta.env.BASE_URL}/` }}
      class="nav-link"
    >
      Project Overview
    </a>

    <div class="section-title">TUTORIAL</div>

    {
      tutorialSteps.map(([number, title, slug]) => (
        <a
          href={`${import.meta.env.BASE_URL}/tutorial/${slug}/`}
          class:list={{
            active:
              currentPath ===
              `${import.meta.env.BASE_URL}/tutorial/${slug}/`,
          }}
          class="step-link"
        >
          <span class="number">{number}</span>
          <span>{title}</span>
        </a>
      ))
    }

    <div class="section-title">RESOURCES</div>

    {
      resources.map((entry) => {
        const slug = entry.id.replace("07_credits_and_resources/", "");

        return (
          <a
            href={`${import.meta.env.BASE_URL}/resources/${slug}/`}
            class="sub-link"
            class:list={{
              active:
                currentPath ===
                `${import.meta.env.BASE_URL}/resources/${slug}/`,
            }}
          >
            {getHeading(entry)}
          </a>
        );
      })
    }

    <div class="section-title">LIBRARY</div>

    {
      library.map((entry) => {
        const slug = entry.id.replace("05_library/", "");

        return (
          <a
            href={`${import.meta.env.BASE_URL}/library/${slug}/`}
            class="sub-link"
            class:list={{
              active:
                currentPath ===
                `${import.meta.env.BASE_URL}/library/${slug}/`,
            }}
          >
            {getHeading(entry)}
          </a>
        );
      })
    }
  </nav>
</aside>

<script>
  const sidebar = document.querySelector(".sidebar");
  const activeLink = sidebar?.querySelector(".active");
  const menuButton = document.querySelector(".menu-button");
  const closeButton = document.querySelector(".close-button");
  const backdrop = document.querySelector(".sidebar-backdrop");

  // Keep the active item centered in the desktop sidebar
  if (sidebar && activeLink) {
    sidebar.scrollTop =
      activeLink.offsetTop -
      sidebar.clientHeight / 2 +
      activeLink.clientHeight / 2;
  }

  const openMenu = () => {
    sidebar?.classList.add("open");
    backdrop?.classList.add("visible");
    menuButton?.setAttribute("aria-expanded", "true");
    document.body.classList.add("menu-open");
  };

  const closeMenu = () => {
    sidebar?.classList.remove("open");
    backdrop?.classList.remove("visible");
    menuButton?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("menu-open");
  };

  menuButton?.addEventListener("click", openMenu);
  closeButton?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);

  // Close menu when a navigation link is clicked
  sidebar?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>

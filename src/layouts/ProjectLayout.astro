---
import Sidebar from "../components/Sidebar.astro";
import "satteri-callouts/theme/obsidian";

interface Props {
  title?: string;
}

const { title = "LiDAR to Heightmap Tutorial" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body>
    <Sidebar />

    <div class="page">
      <main>
        <slot />
      </main>

      <footer>
        © 2026 Stuart King
      </footer>
    </div>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" type="button" aria-label="Close">
        &times;
      </button>

      <button
        class="lightbox-prev"
        type="button"
        aria-label="Previous image"
      >
        &#8592;
      </button>

      <img class="lightbox-image" src="" alt="" />

      <button
        class="lightbox-next"
        type="button"
        aria-label="Next image"
      >
        &#8594;
      </button>
    </div>
  </body>
</html>

<style is:global>
  :root {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    color: #1f2937;
    background: #f3f4f6;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }

  .page {
    margin-left: 280px;
    min-height: 100vh;
  }

  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 64px 56px 100px;
    background: #f8f8f6;
    min-height: 100vh;
  }

  footer {
    max-width: 1000px;
    margin: 0 auto;
    padding: 24px 56px 40px;
    background: #f8f8f6;
    color: #6b7280;
    font-size: 0.8rem;
    text-align: center;
  }

  h1,
  h2,
  h3 {
    color: #111827;
    line-height: 1.2;
  }

  h1 {
    font-size: 2.5rem;
    margin-top: 0;
  }

  h2 {
    margin-top: 2.5rem;
  }

  p {
    line-height: 1.7;
  }

  hr {
    margin: 15px 0;
    border: 0;
    border-top: 4px solid #d0d7de;
  }

  a {
    color: #0F7F99;
  }

  table {
    width: 100%;
    max-width: 100%;
    border-spacing: 0;
    border-collapse: separate;
    margin: 1.5rem 0;
    overflow: hidden;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    overflow-wrap: break-word;
  }

  th,
  td {
    padding: 8px 12px;
    border-right: 1px solid #d0d7de;
    border-bottom: 1px solid #d0d7de;
    text-align: center;
  }

  td code,
  th code {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  th {
    background: #f6f8fa;
    font-weight: 600;
  }

  th:last-child,
  td:last-child {
    border-right: 0;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin: 1.5rem 0;
  min-width: 0;
}

.image-grid img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  min-width: 0;
}

.image-grid-featured img:first-child {
  grid-column: 1 / -1;
}

@media (max-width: 600px) {
  .image-grid {
    grid-template-columns: 1fr;
  }

  .image-grid-featured img:first-child {
    grid-column: auto;
  }
}

  pre {
    overflow-x: auto;
    padding: 18px;
    background: #1f2937;
    color: #f9fafb;
    border-radius: 8px;
  }

  code {
    font-family:
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      monospace;
  }

  :not(pre) > code {
    background: #D1D1D1;
    border: 1px solid #d4d4d4;
    border-radius: 4px;
    padding: 0.1em 0.3em;
  }

  /* Callouts */

  .callout {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-radius: 6px;
    border-left: 4px solid;
    background: #f8f8f8;
  }

  .callout-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }

  .callout-content {
    margin-top: 0.5rem;
  }

  .callout-content p:first-child {
    margin-top: 0;
  }

  .callout-content p:last-child {
    margin-bottom: 0;
  }

  /* NOTE */

  .callout[data-callout="note"] {
    --callout-color: 68, 138, 255;
    border-color: rgb(var(--callout-color));
    background: rgba(var(--callout-color), 0.08);
    color: #1f2937;
  }

  /* TIP */

  .callout[data-callout="tip"] {
    --callout-color: 0, 191, 165;
    border-color: rgb(var(--callout-color));
    background: rgba(var(--callout-color), 0.08);
    color: #1f2937;
  }

  /* IMPORTANT */

  .callout[data-callout="important"] {
    --callout-color: 191, 0, 25;
    border-color: rgb(var(--callout-color));
    background: rgba(var(--callout-color), 0.08);
    color: #1f2937;
  }

  /* WARNING */

  .callout[data-callout="warning"] {
    --callout-color: 255, 145, 0;
    border-color: rgb(var(--callout-color));
    background: rgba(var(--callout-color), 0.08);
    color: #1f2937;
  }

  /* CAUTION */

  .callout[data-callout="caution"] {
    --callout-color: 255, 82, 82;
    border-color: rgb(var(--callout-color));
    background: rgba(var(--callout-color), 0.08);
    color: #1f2937;
  }

  .callout[data-callout="tip"] .callout-title {
    color: rgb(0, 191, 165);
  }

  .callout[data-callout="important"] .callout-title {
    color: rgb(191, 0, 25);
  }

  /* Image lightbox */

  .page main img {
    cursor: zoom-in;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.85);
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox-image {
    display: block;
    max-width: calc(100vw - 40px);
    max-height: calc(100vh - 40px);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lightbox button {
    position: fixed;
    border: 0;
    background: rgba(255, 255, 255, 0.12);
    color: white;
    font-size: 2rem;
    cursor: pointer;
    border-radius: 6px;
    width: 50px;
    height: 50px;
    z-index: 1001;
  }

  .lightbox button:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .lightbox-close {
    top: 20px;
    right: 20px;
  }

  .lightbox-prev {
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 800px) {
    .page {
      margin-left: 0;
    }

    main {
      padding: 40px 24px 80px;
    }

    footer {
      padding: 24px;
    }

    .lightbox {
      padding: 10px;
    }

    .lightbox-image {
      max-width: calc(100vw - 20px);
      max-height: calc(100vh - 20px);
    }

    .lightbox button {
      width: 44px;
      height: 44px;
      font-size: 1.6rem;
    }

    .lightbox-close {
      top: 10px;
      right: 10px;
    }

    .lightbox-prev {
      left: 10px;
    }

    .lightbox-next {
      right: 10px;
    }
  }

  .sidebar {
    width: 280px;
    height: 100vh;
    background: #111827;
    color: #d1d5db;
    position: fixed;
    left: 0;
    top: 0;
    overflow-y: auto;
    box-sizing: border-box;
    padding: 32px 20px;
    z-index: 1000;
  }

  .brand {
    margin-bottom: 40px;
    padding: 0 12px;
    position: relative;
  }

  .brand a {
    color: #d1d5db;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.35;
  }

  .brand-subtitle {
    margin-top: 6px;
    color: #dbd7d1;
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .section-title {
    color: #d1d5db;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin: 24px 12px 8px;
  }

  .nav-link,
  .step-link {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #dbd7d1;
    text-decoration: none;
    border-radius: 6px;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .nav-link {
    padding: 9px 12px;
  }

  .step-link {
    padding: 7px 10px;
    font-size: 0.88rem;
  }

  .nav-link:hover,
  .step-link:hover {
    background: #1f2937;
    color: #d1d5db;
  }

  .active {
    background: #164e63;
    color: #67e8f9;
  }

  .active:hover {
    background: #164e63;
    color: #67e8f9;
  }

  .number {
    width: 26px;
    flex-shrink: 0;
    color: #dbd7d1;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .active .number {
    color: #67e8f9;
  }

  .sub-link {
    display: block;
    padding: 5px 12px 5px 48px;
    color: #dbd7d1;
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .sub-link:hover {
    background: #1f2937;
    color: #d1d5db;
  }

  .sub-link.active {
    background: #164e63;
    color: #67e8f9;
  }

  /* Hidden on desktop */
  .menu-button,
  .close-button,
  .sidebar-backdrop {
    display: none;
  }

  /* Mobile */
  @media (max-width: 800px) {
    .menu-button {
      display: flex;
      align-items: center;
      gap: 8px;

      position: fixed;
      top: 16px;
      left: 16px;

      z-index: 900;

      padding: 9px 13px;

      border: 1px solid #d1d5db;
      border-radius: 6px;

      background: #ffffff;
      color: #111827;

      font-size: 0.85rem;
      font-weight: 600;

      cursor: pointer;

      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .menu-icon {
      font-size: 1rem;
      line-height: 1;
    }

    .sidebar {
      width: min(280px, 85vw);

      transform: translateX(-100%);
      transition: transform 0.25s ease;

      box-shadow: 8px 0 30px rgba(0, 0, 0, 0.2);
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .close-button {
      display: block;

      position: absolute;
      top: -4px;
      right: 0;

      width: 32px;
      height: 32px;

      border: 0;
      background: transparent;

      color: #d1d5db;

      font-size: 1.8rem;
      line-height: 1;

      cursor: pointer;
    }

    .sidebar-backdrop {
      display: block;

      position: fixed;
      inset: 0;

      z-index: 999;

      background: rgba(0, 0, 0, 0.45);

      opacity: 0;
      visibility: hidden;

      transition:
        opacity 0.25s ease,
        visibility 0.25s ease;
    }

    .sidebar-backdrop.visible {
      opacity: 1;
      visibility: visible;
    }

    body.menu-open {
      overflow: hidden;
    }
  }
</style>

<script>
  const images = Array.from(
    document.querySelectorAll(".page main img")
  );

  const lightbox = document.getElementById("lightbox");
  const lightboxImage = document.querySelector(".lightbox-image");
  const closeButton = document.querySelector(".lightbox-close");
  const previousButton = document.querySelector(".lightbox-prev");
  const nextButton = document.querySelector(".lightbox-next");

  let currentIndex = 0;

  function showImage(index) {
    currentIndex = (index + images.length) % images.length;

    const image = images[currentIndex];

    lightboxImage.src = image.src;
    lightboxImage.alt = image.alt;

    lightbox.classList.add("open");
    lightbox.setAttribute("aria-hidden", "false");
  }

  function closeLightbox() {
    lightbox.classList.remove("open");
    lightbox.setAttribute("aria-hidden", "true");
  }

  images.forEach((image, index) => {
    image.addEventListener("click", () => {
      showImage(index);
    });
  });

  closeButton.addEventListener("click", closeLightbox);

  lightbox.addEventListener("click", (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });

  previousButton.addEventListener("click", () => {
    showImage(currentIndex - 1);
  });

  nextButton.addEventListener("click", () => {
    showImage(currentIndex + 1);
  });

  document.addEventListener("keydown", (event) => {
    if (!lightbox.classList.contains("open")) return;

    if (event.key === "Escape") {
      closeLightbox();
    }

    if (event.key === "ArrowLeft") {
      showImage(currentIndex - 1);
    }

    if (event.key === "ArrowRight") {
      showImage(currentIndex + 1);
    }
  });
</script>
